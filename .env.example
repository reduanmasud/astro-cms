# Copy to .env and fill in. Never commit .env.
# Generate strong values with: openssl rand -base64 32

# Shared password for the web UI. At least 12 characters.
CMS_PASSWORD=

# Signs session cookies. At least 32 characters, different from CMS_PASSWORD.
# Changing it signs everyone out.
SESSION_SECRET=

# The one GitHub repository this CMS edits. The server checks access at startup.
# Use a fine-grained token limited to this repository with read/write access
# to "Contents" and "Pull requests".
#
# If GITHUB_OWNER below is an organization, not your own username: set that
# token's "Resource owner" to the organization, not your personal account
# (the default). A personal-account token cannot see organization
# repositories at all — GitHub answers every request for one with a 404,
# indistinguishable from the repository not existing.
GITHUB_TOKEN=
# Owner (user or organization) and repository name, e.g. withastro / blog.
GITHUB_OWNER=
GITHUB_REPOSITORY=
# Branch that pull requests target. Default: main.
# GITHUB_BASE_BRANCH=main

# --- Live collaboration (optional) -------------------------------------------
#
# Set all four values or none. With none, collaboration is off and the editor
# saves directly over the API; the editor shows no "Live" badge. Setting only
# some of them is refused at startup.
#
# These four only tell the CMS where the HocusPocus server is and which secrets
# it shares. They do not start one:
#
#   docker compose up (dev, compose.yaml)
#                          starts a HocusPocus server on port 1234 and passes
#                          it the same secrets, so collaboration works with no
#                          extra setup. Values below are NOT used by this file;
#                          compose.yaml carries its own defaults (already the
#                          service-name URLs below).
#
#   docker compose -f compose.prod.yaml --profile hocuspocus up (production)
#                          starts the same server from a real image instead of
#                          bind-mounted source, but reads these values from
#                          .env directly — nothing is hardcoded. Server-side
#                          values (HOCUSPOCUS_INTERNAL_URL, the two secrets)
#                          MUST use the Compose service name "hocuspocus", not
#                          "localhost": the server container resolves that
#                          name on the Compose network, and has no route to
#                          the host's loopback. HOCUSPOCUS_PUBLIC_URL is
#                          different on purpose — the browser runs on the
#                          host, outside that network, and needs the port
#                          Compose published instead.
#
#   pnpm dev               starts only the API and Vite. For collaboration,
#                          run a server in a second terminal:
#                            HOCUSPOCUS_JWT_SECRET=... \
#                            HOCUSPOCUS_WEBHOOK_SECRET=... \
#                            CMS_WEBHOOK_URL=http://localhost:3000/api/collab/webhook \
#                            PORT=1234 \
#                            node apps/collab/src/main.ts
#                          then uncomment the four values below, with
#                          HOCUSPOCUS_INTERNAL_URL set to ws://localhost:1234
#                          (no Docker network here, so no service name).
#
# Running your own HocusPocus server instead of the bundled one (either
# compose file, profile or no) — point both URLs at it. It must verify the
# CMS's JWT (HS256; the room is the `aud` claim) and run the webhook
# extension against POST /api/collab/webhook with the `create` and `change`
# events. See docs/adr/0016-collaboration-service.md.

# Where the browser connects. Must be reachable from the user's machine. With
# compose.prod.yaml and the bundled HocusPocus service, this port must match
# HOCUSPOCUS_HOST_PORT below (they default to the same 1234, so usually
# there's nothing to change here).
# HOCUSPOCUS_PUBLIC_URL=ws://localhost:1234

# compose.prod.yaml only, and only if something else on your machine already
# holds host port 1234 (docker compose will refuse to start and say so): the
# HOST side of the bundled HocusPocus service's port mapping. The container
# side always stays 1234 — HOCUSPOCUS_INTERNAL_URL below is unaffected either
# way, since that traffic never leaves the Compose network. Change this and
# HOCUSPOCUS_PUBLIC_URL's port together.
# HOCUSPOCUS_HOST_PORT=1234

# The same server as seen by the CMS and MCP, inside your network. Using the
# bundled HocusPocus service under Docker Compose: the service name,
# ws://hocuspocus:1234 (shown here) — always port 1234 here regardless of
# HOCUSPOCUS_HOST_PORT above. Running your own, elsewhere: whatever hostname
# reaches it from the server container/process.
# HOCUSPOCUS_INTERNAL_URL=ws://hocuspocus:1234

# Two different secrets, 32+ characters each, shared with that server.
# Changing the JWT secret ends every open editing session.
# HOCUSPOCUS_JWT_SECRET=
# HOCUSPOCUS_WEBHOOK_SECRET=

# --- Media storage (optional) ------------------------------------------------
#
# Set all six values or none. With none, media upload is off and /api/media
# answers 404. Works with AWS S3, Cloudflare R2, and MinIO.
#
#   docker compose up (dev, compose.yaml)
#                          starts MinIO on port 9000 (console on 9001) with
#                          the values below already matching, so uploads work
#                          out of the box. Create the bucket once at
#                          http://localhost:9001 (user/password: minioadmin).
#
#   docker compose -f compose.prod.yaml --profile minio up (production)
#                          same MinIO, from compose.prod.yaml, but again reads
#                          these values from .env with nothing hardcoded.
#                          S3_ENDPOINT (server-side) must be the Compose
#                          service name, http://minio:9000, not localhost —
#                          same reasoning as HOCUSPOCUS_INTERNAL_URL above.
#                          S3_PUBLIC_URL stays host-facing: the browser loads
#                          media URLs directly, outside the Compose network.
#
# Using AWS S3, Cloudflare R2, or a MinIO you run elsewhere: S3_ENDPOINT and
# S3_PUBLIC_URL are typically the same reachable hostname, not the service
# name above.
#
# Credentials stay on the server; the browser only ever receives public URLs.

# S3_ENDPOINT=http://minio:9000
# S3_BUCKET=astro-cms-media
# S3_REGION=us-east-1
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin

# Where objects are publicly served from. For MinIO with a public bucket this
# is the endpoint plus the bucket name. With compose.prod.yaml and the
# bundled MinIO, this port must match S3_HOST_PORT below (they default to
# the same 9000, so usually there's nothing to change here).
# S3_PUBLIC_URL=http://localhost:9000/astro-cms-media

# compose.prod.yaml only, and only if something else on your machine already
# holds host port 9000 or 9001: the HOST side of the bundled MinIO's port
# mapping (API and console). The container side always stays 9000/9001 —
# S3_ENDPOINT above is unaffected either way, since that traffic never
# leaves the Compose network. Change S3_HOST_PORT and S3_PUBLIC_URL's port
# together; S3_CONSOLE_HOST_PORT (MinIO's own web UI, not used by the CMS)
# has no matching app-side value to keep in sync.
# S3_HOST_PORT=9000
# S3_CONSOLE_HOST_PORT=9001

# compose.prod.yaml only: the host port the CMS itself (the web container,
# nginx serving the built app and proxying /api) is published on — what you
# actually open in a browser. Change this if something else already holds
# port 80. Unlike the two above, nothing else needs to stay in sync: there's
# no "public URL" setting for the CMS to match, you just visit whatever port
# you set here.
# WEB_HOST_PORT=80

# Media collection. Unused files are deleted after the grace period, once
# nothing in any draft, open CMS pull request, or the base branch refers to
# them. Set the interval to 0 to switch collection off. The grace period is
# at least 1 day; there is no way to delete without one.
#
# MEDIA_GC_INTERVAL_HOURS=6
# MEDIA_GC_GRACE_DAYS=7

# --- MCP (optional) ----------------------------------------------------------
#
# A static token for the MCP endpoint at POST /api/mcp. Unset, MCP is off and
# that route answers 404. This is separate from CMS_PASSWORD: the browser uses
# the password and a session cookie, an MCP client uses this token.
#
#   openssl rand -hex 32
#
# MCP_TOKEN=

# HTTP port of the API server. Default: 3000.
# PORT=3000

# Where SQLite data is stored. Default: ./data relative to apps/server
# (Docker Compose: the cms-data volume).
# DATA_DIR=./data

# Mark the session cookie Secure (HTTPS only).
# Default: true when NODE_ENV=production, otherwise false.
# COOKIE_SECURE=false
