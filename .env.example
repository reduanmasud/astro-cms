# Copy to .env and fill in. Never commit .env.
# Generate strong values with: openssl rand -base64 32

# Shared password for the web UI. At least 12 characters.
CMS_PASSWORD=

# Signs session cookies. At least 32 characters, different from CMS_PASSWORD.
# Changing it signs everyone out.
SESSION_SECRET=

# The one GitHub repository this CMS edits. The server checks access at startup.
# Use a fine-grained token limited to this repository with read/write access
# to "Contents" and "Pull requests".
GITHUB_TOKEN=
# Owner (user or organization) and repository name, e.g. withastro / blog.
GITHUB_OWNER=
GITHUB_REPOSITORY=
# Branch that pull requests target. Default: main.
# GITHUB_BASE_BRANCH=main

# --- Live collaboration (optional) -------------------------------------------
#
# Set all four values or none. With none, collaboration is off and the editor
# saves directly over the API; the editor shows no "Live" badge. Setting only
# some of them is refused at startup.
#
# These four only tell the CMS where the HocusPocus server is and which secrets
# it shares. They do not start one:
#
#   docker compose up      starts a HocusPocus server on port 1234 and passes
#                          it the same secrets, so collaboration works with no
#                          extra setup. Values below are NOT used by Compose;
#                          compose.yaml carries its own defaults.
#
#   pnpm dev               starts only the API and Vite. For collaboration,
#                          run a server in a second terminal:
#                            HOCUSPOCUS_JWT_SECRET=... \
#                            HOCUSPOCUS_WEBHOOK_SECRET=... \
#                            CMS_WEBHOOK_URL=http://localhost:3000/api/collab/webhook \
#                            PORT=1234 \
#                            node apps/collab/src/main.ts
#                          then uncomment the four values below.
#
# In production, point these at the HocusPocus server you run. It must verify
# the CMS's JWT (HS256; the room is the `aud` claim) and run the webhook
# extension against POST /api/collab/webhook with the `create` and `change`
# events. See docs/adr/0016-collaboration-service.md.

# Where the browser connects. Must be reachable from the user's machine.
# HOCUSPOCUS_PUBLIC_URL=ws://localhost:1234

# The same server as seen by the CMS and MCP, inside your network.
# Locally this is the same URL; in Docker it is the service name.
# HOCUSPOCUS_INTERNAL_URL=ws://localhost:1234

# Two different secrets, 32+ characters each, shared with that server.
# Changing the JWT secret ends every open editing session.
# HOCUSPOCUS_JWT_SECRET=
# HOCUSPOCUS_WEBHOOK_SECRET=

# --- Media storage (optional) ------------------------------------------------
#
# Set all six values or none. With none, media upload is off and /api/media
# answers 404. Works with AWS S3, Cloudflare R2, and MinIO.
#
#   docker compose up      starts MinIO on port 9000 (console on 9001) with
#                          the values below already matching, so uploads work
#                          out of the box. Create the bucket once at
#                          http://localhost:9001 (user/password: minioadmin).
#
# Credentials stay on the server; the browser only ever receives public URLs.

# S3_ENDPOINT=http://localhost:9000
# S3_BUCKET=astro-cms-media
# S3_REGION=us-east-1
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin

# Where objects are publicly served from. For MinIO with a public bucket this
# is the endpoint plus the bucket name.
# S3_PUBLIC_URL=http://localhost:9000/astro-cms-media

# Media collection. Unused files are deleted after the grace period, once
# nothing in any draft, open CMS pull request, or the base branch refers to
# them. Set the interval to 0 to switch collection off. The grace period is
# at least 1 day; there is no way to delete without one.
#
# MEDIA_GC_INTERVAL_HOURS=6
# MEDIA_GC_GRACE_DAYS=7

# --- MCP (optional) ----------------------------------------------------------
#
# A static token for the MCP endpoint at POST /api/mcp. Unset, MCP is off and
# that route answers 404. This is separate from CMS_PASSWORD: the browser uses
# the password and a session cookie, an MCP client uses this token.
#
#   openssl rand -hex 32
#
# MCP_TOKEN=

# HTTP port of the API server. Default: 3000.
# PORT=3000

# Where SQLite data is stored. Default: ./data relative to apps/server
# (Docker Compose: the cms-data volume).
# DATA_DIR=./data

# Mark the session cookie Secure (HTTPS only).
# Default: true when NODE_ENV=production, otherwise false.
# COOKIE_SECURE=false
